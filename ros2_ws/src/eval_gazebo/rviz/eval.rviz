Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Value: true
    - Class: rviz_default_plugins/Path
      Name: EvalPath
      Enabled: true
      Topic:
        Value: /eval/path
        Durability Policy: Transient Local
      Color: 150; 150; 150
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: PredictedTrajectory
      Enabled: true
      Topic:
        Value: /local_planner/markers
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot
      Enabled: true
      Topic:
        Value: /ground_truth/odom
      Keep: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Human1
      Enabled: true
      Topic:
        Value: /humans/human_1/odom
      Keep: 1
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Human2
      Enabled: true
      Topic:
        Value: /humans/human_2/odom
      Keep: 1
      Value: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      X: 5
      Y: 0
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
